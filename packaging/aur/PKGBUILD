# Maintainer: Roman Dymchenko <daregod@users.noreply.github.com>
pkgname=ext-tags-bin
pkgver=0.10.3
pkgrel=1
pkgdesc="Write and import foobar2000 external .tag files"
arch=('x86_64' 'aarch64')
url="https://github.com/daregod/ext-tags"
license=('MIT')
provides=('ext-tags')
conflicts=('ext-tags')
options=('!strip')

source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::https://github.com/daregod/ext-tags/releases/download/v${pkgver}/ext-tags_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.tar.gz::https://github.com/daregod/ext-tags/releases/download/v${pkgver}/ext-tags_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('b5ae335d24134e023e78887c7e26169f617850ce3f8eac8baddee2e1518bc44b')
sha256sums_aarch64=('d8f92ac65994e99b9e7b4ccdabcf48f5d76e86f7b9825955d5c4ce174500fb9c')

package() {
  local binary="ext-tags_linux_amd64"
  if [[ "$CARCH" == "aarch64" ]]; then
    binary="ext-tags_linux_arm64"
  fi
  install -Dm755 "$srcdir/$binary" "$pkgdir/usr/bin/ext-tags"
}
